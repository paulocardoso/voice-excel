# Leave empty to run with deterministic demo speech feedback.
# In production, point this to your authenticated server-side assessment API.
EXPO_PUBLIC_ASSESSMENT_API_URL=https://api.example.com

# Setting both values enables passwordless Supabase authentication. Without
# them, WorkVoice intentionally runs as a local-device demo.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Development only: set to `anonymous` to skip the email sign-in screen and use a
# Supabase anonymous account (enable "Allow anonymous sign-ins" in Supabase).
# Ignored in release builds.
EXPO_PUBLIC_DEV_AUTH_BYPASS=

# Platform-specific public RevenueCat SDK keys. Configure a `pro` entitlement
# and a current offering in RevenueCat before enabling live purchases.
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=appl_your_public_key
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=goog_your_public_key
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_ID=pro

# Optional: forward anonymous product events to your own analytics gateway.
EXPO_PUBLIC_ANALYTICS_API_URL=https://api.example.com/events


