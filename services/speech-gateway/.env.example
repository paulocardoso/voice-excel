PORT=8787
ALLOWED_ORIGINS=https://app.example.com

# Supabase validates the mobile access token and stores only derived results.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Azure Speech remains server-side only.
AZURE_SPEECH_KEY=your-speech-key
# Region of the Speech resource, e.g. westeurope. Required unless the resource
# has a custom domain (endpoint https://<name>.cognitiveservices.azure.com/).
AZURE_SPEECH_REGION=
AZURE_SPEECH_RESOURCE_NAME=your-speech-resource-name

# Configure this as the Authorization secret on the RevenueCat webhook. The
# webhook, not the mobile client, is allowed to grant the `pro` plan.
REVENUECAT_WEBHOOK_AUTHORIZATION=a-long-random-secret
REVENUECAT_PRO_ENTITLEMENT_ID=pro

# Optional model voice for pronunciation playback. Pick one American and one
# British voice in your ElevenLabs voice library and paste their voice IDs.
# Without these, the app falls back to the device's built-in voices.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID_US=
ELEVENLABS_VOICE_ID_GB=
# Defaults to eleven_multilingual_v2; eleven_v4 is ElevenLabs' newest high-quality model.
ELEVENLABS_MODEL_ID=
